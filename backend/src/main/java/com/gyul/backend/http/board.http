// 게시판 API 테스트

@host = localhost:8080

### 0. 시작 전 로그아웃 (이전 테스트의 로그인 쿠키 정리, 기대 결과 : 204)
POST http://{{host}}/api/members/logout


### 1. 글 목록 - 로그인 없이 (기대 결과 : 200, 샘플 글 3개 이상)
GET http://{{host}}/api/boards


### 2. 글 작성 - 로그인 안 함 (기대 결과 : 401)
POST http://{{host}}/api/boards
Content-Type: application/json

{
  "title": "로그인 없이 쓰기",
  "content": "막혀야 정상"
}


### 3. gyul01 로그인 (기대 결과 : 200)
POST http://{{host}}/api/members/login
Content-Type: application/json

{
  "username": "gyul01",
  "password": "gyul1234"
}


### 4. 글 작성 - 성공 (기대 결과 : 201, 응답에 boardId)
# @name createBoard
POST http://{{host}}/api/boards
Content-Type: application/json

{
  "title": "REST Client 로 쓴 글",
  "content": "첫째 줄\n둘째 줄"
}


### 5. 방금 쓴 글 상세 (기대 결과 : 200)
GET http://{{host}}/api/boards/{{createBoard.response.body.boardId}}


### 6. 글 작성 - 입력값 오류 (기대 결과 : 400, errors 에 title, content)
POST http://{{host}}/api/boards
Content-Type: application/json

{
  "title": "",
  "content": "   "
}


### 7. 글 수정 - 작성자 본인 (기대 결과 : 200, 바뀐 제목, updatedAt 변경)
PUT http://{{host}}/api/boards/{{createBoard.response.body.boardId}}
Content-Type: application/json

{
  "title": "REST Client 로 수정한 글",
  "content": "수정된 내용입니다."
}


### 8. 다른 회원 gyul02 가입 (기대 결과 : 201, 이미 가입했다면 409 - 둘 다 괜찮음)
POST http://{{host}}/api/members/signup
Content-Type: application/json

{
  "username": "gyul02",
  "password": "gyul1234",
  "name": "귤학생",
  "email": "gyul02@test.com"
}


### 9. gyul02 로그인 (기대 결과 : 200) → 이제부터 gyul02 로 요청된다
POST http://{{host}}/api/members/login
Content-Type: application/json

{
  "username": "gyul02",
  "password": "gyul1234"
}


### 10. 남의 글 수정 (기대 결과 : 403)
PUT http://{{host}}/api/boards/{{createBoard.response.body.boardId}}
Content-Type: application/json

{
  "title": "남의 글 고치기",
  "content": "막혀야 정상"
}


### 11. 남의 글 삭제 (기대 결과 : 403)
DELETE http://{{host}}/api/boards/{{createBoard.response.body.boardId}}


### 12. 다시 gyul01 로그인 (기대 결과 : 200)
POST http://{{host}}/api/members/login
Content-Type: application/json

{
  "username": "gyul01",
  "password": "gyul1234"
}


### 13. 내 글 삭제 (기대 결과 : 204)
DELETE http://{{host}}/api/boards/{{createBoard.response.body.boardId}}


### 14. 삭제한 글 상세 (기대 결과 : 404)
GET http://{{host}}/api/boards/{{createBoard.response.body.boardId}}